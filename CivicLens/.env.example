# CivicLens Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=civiclens_sih25031_secret_key_2026

# Municipal Nodal Officer Email for automated alerts
# Leave blank to dynamically derive domain from reverse-geocoded city (e.g. nodal.officer@kanpur.gov.in)
NODAL_OFFICER_EMAIL=

# Email SMTP Settings (Leave empty to use automatic Ethereal test mailer with preview URLs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="CivicLens Municipal Dispatch" <alerts@civiclens.gov.in>
